<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password | Task Manager</title>
  <link rel="stylesheet" href="/index.css">
</head>
<body>
  <div class="auth-wrapper">
    <div class="glass-panel auth-card">
      <div class="auth-header">
        <h1>Reset Password</h1>
        <p><%= typeof step !== 'undefined' && step === 2 ? 'Step 2: Enter OTP & New Password' : 'Step 1: Enter your registered email' %></p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert-success" style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); color: #4ade80; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.9rem;">
          ✅ <%= success %>
        </div>
      <% } %>

      <% if (typeof step !== 'undefined' && step === 2) { %>
        <!-- STEP 2: Verify OTP & Reset Password Form -->
        <form action="/reset-password" method="POST">
          <input type="hidden" name="email" value="<%= email %>">

          <div class="form-group">
            <label>Email</label>
            <input type="email" class="form-control" value="<%= email %>" disabled>
          </div>

          <div class="form-group">
            <label for="otp">Enter 6-Digit OTP</label>
            <input 
              type="text"
              inputmode="numeric" 
              id="otp"
              name="otp" 
              class="form-control" 
              placeholder="Enter 6-digit code"
              maxlength="6"
              required
            >
          </div>

          <div class="form-group">
            <label for="password">New Password</label>
            <input 
              type="password" 
              id="password"
              name="password" 
              class="form-control" 
              placeholder="At least 6 characters"
              required
              minlength="6"
            >
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input 
              type="password" 
              id="confirmPassword"
              name="confirmPassword" 
              class="form-control" 
              placeholder="Re-enter new password"
              required
              minlength="6"
            >
          </div>

          <button type="submit" id="update-btn" class="btn btn-primary">Update Password</button>
        </form>

        <div style="text-align: center; margin-top: 1.25rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem;">Didn't receive the OTP?</p>
          <button type="button" id="resend-btn" class="btn btn-secondary" style="width: auto; padding: 8px 16px; font-size: 0.85rem;" disabled>
            Resend OTP (<span id="countdown">60</span>s)
          </button>
        </div>

        <div style="text-align: center; margin-top: 1rem;">
          <a href="/resetPassword" style="color: #94a3b8; font-size: 0.875rem;">← Change email</a>
        </div>
      <% } else { %>
        <!-- STEP 1: Request OTP Form -->
        <form action="/forgot-password" method="POST">
          <div class="form-group">
            <label for="email">Email Address</label>
            <input 
              type="email" 
              id="email"
              name="email" 
              class="form-control" 
              placeholder="Enter your registered email"
              value="<%= typeof email !== 'undefined' ? email : '' %>"
              required
            >
          </div>

          <button type="submit" id="send-otp-btn" class="btn btn-primary">Send OTP</button>
        </form>

        <div class="auth-footer" style="margin-top: 1.5rem; text-align: center;">
          Remembered your password? <a href="/login">Back to Sign In</a>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    // Form submit loading states
    document.querySelectorAll('form').forEach(form => {
      form.addEventListener('submit', function() {
        const btn = this.querySelector('button[type="submit"]');
        if (btn && !btn.disabled) {
          btn.disabled = true;
          if (this.action.includes('forgot-password')) {
            btn.innerHTML = `<span class="spinner"></span> Sending OTP...`;
          } else if (this.action.includes('reset-password')) {
            btn.innerHTML = `<span class="spinner"></span> Updating Password...`;
          } else {
            btn.innerHTML = `<span class="spinner"></span> Processing...`;
          }
        }
      });
    });

    // Resend OTP Countdown & Handler for Step 2
    const resendBtn = document.getElementById('resend-btn');
    if (resendBtn) {
      let timerInterval = null;

      function startTimer(seconds) {
        let timeLeft = seconds;
        resendBtn.disabled = true;
        resendBtn.innerHTML = `Resend OTP (<span id="countdown">${timeLeft}</span>s)`;

        if (timerInterval) clearInterval(timerInterval);

        timerInterval = setInterval(() => {
          timeLeft--;
          const countdownEl = document.getElementById('countdown');
          if (countdownEl) countdownEl.innerText = timeLeft;

          if (timeLeft <= 0) {
            clearInterval(timerInterval);
            resendBtn.disabled = false;
            resendBtn.innerHTML = `🔄 Resend OTP`;
          }
        }, 1000);
      }

      // Start initial 60s countdown
      startTimer(60);

      // Handle Resend button click
      resendBtn.addEventListener('click', async () => {
        resendBtn.disabled = true;
        resendBtn.innerHTML = `<span class="spinner"></span> Resending OTP...`;

        try {
          const response = await fetch('/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ email: '<%= typeof email !== "undefined" ? email : "" %>' })
          });

          // Show success alert
          let alertDiv = document.querySelector('.alert-success');
          if (!alertDiv) {
            alertDiv = document.createElement('div');
            alertDiv.className = 'alert-success';
            alertDiv.style.cssText = 'background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); color: #4ade80; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.9rem;';
            const header = document.querySelector('.auth-header');
            header.after(alertDiv);
          }
          alertDiv.innerHTML = '✅ New OTP sent successfully! Please check your email.';

          // Hide error alert if present
          const errorDiv = document.querySelector('.alert-error');
          if (errorDiv) errorDiv.style.display = 'none';

          // Restart 60 second timer
          startTimer(60);
        } catch (err) {
          console.error(err);
          resendBtn.disabled = false;
          resendBtn.innerHTML = `🔄 Resend OTP`;
        }
      });
    }
  </script>
</body>
</html>
